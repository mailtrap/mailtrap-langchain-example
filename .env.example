# Mailtrap
MAILTRAP_API_TOKEN=
MAILTRAP_SENDER_EMAIL=sender@yourdomain.com
MAILTRAP_SENDER_NAME=Demo Bot
# true = send into a Sandbox inbox (safe for testing, requires MAILTRAP_INBOX_ID).
# false = send real mail via the production Sending API (requires a verified
# sending domain in your Mailtrap account; MAILTRAP_INBOX_ID is ignored).
MAILTRAP_SANDBOX=true
MAILTRAP_INBOX_ID=1234567

# Guardrail: recipient must be on this domain, or match OWN_EMAIL exactly
ALLOWED_RECIPIENT_DOMAIN=example.com
OWN_EMAIL=you@yourcompany.com

# LLM — pick ONE provider block below and set LLM_API_KEY to that provider's
# key. LLM_PROVIDER/LLM_MODEL/LLM_API_KEY are passed explicitly to
# init_chat_model(f"{LLM_PROVIDER}:{LLM_MODEL}", api_key=LLM_API_KEY). Any
# provider LangChain supports works here as long as the matching
# langchain-<provider> package is installed.

# OpenAI (default)
#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=

# Anthropic
#LLM_PROVIDER=anthropic
#LLM_MODEL=claude-3-5-haiku-latest
#LLM_API_KEY=

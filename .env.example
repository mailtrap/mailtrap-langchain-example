# Copy to .env and fill in — see the Setup section of README.md for details.
# Required, must be non-empty: MAILTRAP_API_TOKEN, MAILTRAP_SENDER_EMAIL, LLM_API_KEY.
# Never paste a real key into this file — it is tracked by git; .env is not.

MAILTRAP_API_TOKEN=
# Sending goes through the production Sending API, so this address must be on a
# domain verified under Sending Domains in your Mailtrap account.
MAILTRAP_SENDER_EMAIL=sender@yourdomain.com
MAILTRAP_SENDER_NAME=Demo Bot

# Guardrail: recipient must be on this domain, or match OWN_EMAIL exactly.
# Heads-up: example.com is reserved for docs and accepts NO mail (null MX), so
# anything sent there is accepted by Mailtrap and then hard-bounces. It works
# well as a default that blocks everything except OWN_EMAIL — just don't use it
# as a real recipient. Hard bounces hurt your account's sending reputation.
ALLOWED_RECIPIENT_DOMAIN=example.com
# Your own real address — this is the one to actually send to while testing.
# It's a mailbox you can read, so it needn't be on the verified sending domain.
OWN_EMAIL=you@yourcompany.com

# Keep ONE provider block active. Any provider works once its
# langchain-<provider> package is installed; these three ship with the repo.
# Google Gemini (default) — free tier, key from https://aistudio.google.com/apikey
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=

#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=

#LLM_PROVIDER=anthropic
#LLM_MODEL=claude-3-5-haiku-latest
#LLM_API_KEY=
